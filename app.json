{
  "expo": {
    "name": "Eternal India",
    "slug": "EternalIndiaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icon.png",
    "scheme": "eternalindiaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/app-icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.mukeshy5.EternalIndiaApp"
    },
    "web": {
      "output": "server",
      "bundler": "metro",
      "favicon": "./src/assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EB",
          "image": "./src/assets/app-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ea8cfca1-e982-4be2-b194-5fad3eb956bc"
      }
    }
  }
}
